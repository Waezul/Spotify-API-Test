# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI (localhost is not allowed; use 127.0.0.1):
#   http://127.0.0.1:8000/auth/callback
# Enable Web API (and Web Playback SDK if you need in-browser playback).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
APP_HOST=127.0.0.1
APP_PORT=8000
